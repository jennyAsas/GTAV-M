APP_NAME="GTAV-M"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Supabase Postgres. Use the SESSION pooler connection string (port 5432).
# The transaction pooler (port 6543) does not support prepared statements.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# First administrator, created by `php artisan db:seed`. No default password exists:
# if ADMIN_PASSWORD is empty, no administrator is created.
ADMIN_NAME="Global Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase Storage (S3-compatible). Only needed for the deferred materials feature.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
